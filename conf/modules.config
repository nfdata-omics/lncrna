/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    //==========================
    // QC
    //==========================

    withName: FASTQC {
        ext.prefix =  { "${meta.id}_raw" }
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/qc/raw_fastqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*FASTQC_TRIM.*' {
        ext.prefix =  { "${meta.id}_trim" }
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/qc/trim_fastqc/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'TRIMGALORE' {
        publishDir = [
            path: { "${params.outdir}/qc/trimgalore" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FASTP' {
        publishDir = [
            path: { "${params.outdir}/qc/fastp" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CAT_FASTQ' {
        publishDir = [
            path: { "${params.outdir}/qc/merged_fastq" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS' {
        publishDir = [
            path: { "${params.outdir}/qc/qc/trim_fastqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'FQ_LINT' {
        ext.args = { params.extra_fqlint_args ?: '' }
    }
    withName: 'FQ_LINT_AFTER_TRIMMING' {
        ext.args = { params.extra_fqlint_args ?: '' }
    }
    withName: 'FQ_LINT_AFTER_BBSPLIT' {
        ext.args = { params.extra_fqlint_args ?: '' }
    }
    withName: 'FQ_LINT_AFTER_RIBO_REMOVAL' {
        ext.args = { params.extra_fqlint_args ?: '' }
    }

    //==========================
    // MAPPING
    //==========================

    withName: 'SAMTOOLS_*' {
        ext.prefix = { "${meta.id}.sorted" }
        publishDir = [
            path: { "${params.outdir}/alignment/samtools/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PICARD_MARKDUPLICATES' {
        publishDir = [
            path: { "${params.outdir}/alignment/markduplicates/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'STAR_GENOMEGENERATE' {
        publishDir = [
            path: { "${params.outdir}/alignment/star/star_index" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename?.startsWith('star/') ? filename.substring(5) : filename
            }
        ]
    }

    withName: 'STAR_ALIGN' {
        ext.args = { "--readFilesCommand zcat --outSAMtype BAM Unsorted SortedByCoordinate" + (params.extra_star_align_args ? " ${params.extra_star_align_args}" : "") }
        publishDir = [
            path: { "${params.outdir}/alignment/star/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    //==========================
    // STRINGTIE SUBWORKFLOW
    //==========================
    withName: 'STRINGTIE_STRINGTIE' {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/stringtie/stringtie/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'STRINGTIE_MERGE' {
        publishDir = [
            path: { "${params.outdir}/stringtie/merge" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GFFCOMPARE' {
        ext.args = '-R'
        publishDir = [
            path: { "${params.outdir}/stringtie/gffcompare" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FILTER_GTF_BY_CLASSCODE' {
        ext.args = { params.classcodes ?: 'i,u,x,j' }
        publishDir = [
            path: { "${params.outdir}/stringtie/filter_by_classcode" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'NFDATAOMICS_LNCRNA:LNCRNA:STRINGTIE_WORKFLOW:GTF_TO_FASTA' {
        publishDir = [
            path: { "${params.outdir}/stringtie/gtf_to_fasta" },
            mode: params.publish_dir_mode
        ]
    }

    //==========================
    // PREPARE GENOME
    //==========================
    withName: 'FASTA_EXTRACT_TRANSCRIPTS' {
        ext.args = '-w'  // obtain transcript sequences
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode
        ]
    }

    // Extract protein sequences from GTF using gffread (-y)
    withName: 'PROTEIN_EXTRACT' {
        ext.args = '-y'
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/genome/sequences" },
            mode: params.publish_dir_mode,
            enabled: params.novel_lncrnas
        ]
    }

     // EXTRACT SEQUENCES
    withName: 'EXTRACT_LNCRNA_SEQUENCES' {
        publishDir = [
            path: { "${params.outdir}/genome/sequences" },
            mode: params.publish_dir_mode,
            enabled: params.novel_lncrnas
        ]
    }

    withName: 'EXTRACT_MRNA_SEQUENCES' {
        publishDir = [
            path: { "${params.outdir}/genome/sequences" },
            mode: params.publish_dir_mode,
            enabled: params.novel_lncrnas
        ]
    }

    withName: 'EXTRACT_CDS_SEQUENCES' {
        publishDir = [
            path: { "${params.outdir}/genome/sequences" },
            mode: params.publish_dir_mode,
            enabled: params.novel_lncrnas
        ]
    }

    withName: 'EXTRACT_PROTEIN_SEQUENCES' {
        publishDir = [
            path: { "${params.outdir}/genome/sequences" },
            mode: params.publish_dir_mode,
            enabled: params.novel_lncrnas
        ]
    }

    // PROTEIN-CODING GTF FILTER
    withName: 'GTF_FILTER_PROTEIN_CODING' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode
        ]
    }
    //==========================
    // LNCRNAS CLASSIFICATION
    //==========================
    withName: 'CLASSIFY_LNCRNA' {
        publishDir = [
            path: { "${params.outdir}/lncrnas_classification" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename == 'README.txt') {
                    return "README.txt"
                }
                return filename.startsWith('lncrnas_classification') ? "${filename}" : filename
            }
        ]
    }

    //==========================
    // QUANTIFICATION AND COUNTS MATRIX
    //==========================
    withName: '.*SE_GENE_UNIFIED' {
        ext.prefix = { "${meta.id}_gene" }
        ext.args = '--assay_names counts,counts_length_scaled,counts_scaled,lengths,tpm --coldata_id_col sample --rowdata_id_col gene_id'
        publishDir = [
            path: { "${params.outdir}/pseudo_alignment/summarized_experiment" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*SE_TRANSCRIPT_UNIFIED' {
        ext.prefix = { "${meta.id}_transcript" }
        ext.args = '--assay_names counts,lengths,tpm --coldata_id_col sample --rowdata_id_col transcript_id'
        publishDir = [
            path: { "${params.outdir}/pseudo_alignment/summarized_experiment" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SALMON_INDEX' {
        publishDir = [
            path: { "${params.outdir}/pseudo_alignment/salmon/salmon_index" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SALMON_QUANT' {
        publishDir = [
            path: { "${params.outdir}/pseudo_alignment/salmon/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'KALLISTO_QUANT' {
        publishDir = [
            path: { "${params.outdir}/pseudo_alignment/kallisto/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'TXIMETA_TXIMPORT' {
        publishDir = [
            path: { "${params.outdir}/pseudo_alignment/expression_tables" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.contains("gene")) {
                    return "gene/${filename}"
                } else if (filename.contains("transcript")) {
                    return "transcripts/${filename}"
                } else {
                    return filename
                }
            }
        ]
    }

    withName: 'CUSTOM_TX2GENE' {
        publishDir = [
            path: { "${params.outdir}/pseudo_alignment/expression_tables" },
            mode: params.publish_dir_mode
        ]
    }

    //==========================
    // ANALYSIS_CIS_TRANS
    //==========================
    withName: 'ANALYSIS_CIS' {
        publishDir = [
            path: { "${params.outdir}//cis_trans" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ANALYSIS_TRANS' {
        //ext.args   = '--method spearman --min_corr 0.5 --pvalue 0.05 --chunk_size 100'
        publishDir = [
            path: { "${params.outdir}//cis_trans" },
            mode: params.publish_dir_mode
        ]
    }

    //==========================
    // QUANTIFY_EXPRESSION
    //==========================
    withName: 'QUANTIFY_EXPRESSION' {
        publishDir = [
            path: { "${params.outdir}/quantification/featurecounts/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SUBREAD_FEATURECOUNTS' {
        publishDir = [
            path: { "${params.outdir}/quantification/featurecounts/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GENERATE_COUNT_MATRIX' {
        publishDir = [
            path: { "${params.outdir}/quantification/expression_tables" },
            mode: params.publish_dir_mode
        ]
    }

    //==========================
    // DIFFERENTIAL EXPRESSION
    //==========================
    withName: 'DIFFERENTIAL_EXPRESSION' {
        publishDir = [
            path: { "${params.outdir}/differential_expression" },
            mode: params.publish_dir_mode
            // saveAs: { filename ->
            //     filename?.startsWith('star/') ? filename.substring(5) : filename
            // }
        ]
    }

    withName: 'GTF2BED' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GTF_FILTER' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GTF_FILTER_LNCRNA' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PREPROCESS_TRANSCRIPTS_FASTA_GENCODE' {
        publishDir = [
            path: { "${params.outdir}/genome/sequences" },
            mode: params.publish_dir_mode,
            enabled: params.novel_lncrnas
        ]
    }

    //==========================
    // IDENTIFY_NOVEL_LNCRNA
    //==========================
    withName: 'FILTER_TRANSCRIPTS_EXONS' {
        publishDir = [
            path: { "${params.outdir}/identify_novel_lncrnas/exon" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FILTER_TRANSCRIPTS_LENGTH' {
        publishDir = [
            path: { "${params.outdir}/identify_novel_lncrnas/transcript" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CPAT_BUILD_MODEL' {
        cpus = 4
        memory = '8.GB'
        time = '2.h'
        publishDir = [
            path: { "${params.outdir}/identify_novel_lncrnas/cpat" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename }
        ]
    }

    withName: 'CPAT' {
        cpus = 4
        memory = '8.GB'
        publishDir = [
            path: { "${params.outdir}/identify_novel_lncrnas/cpat" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PLEK_RUN|PLEK_PARSE' {
        publishDir = [
            path: { "${params.outdir}/identify_novel_lncrnas/plek" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FEELNC_CODPOT_RUN|FEELNC_CODPOT_PARSE ' {
        publishDir = [
            path: { "${params.outdir}/identify_novel_lncrnas/feelnc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'COMBINE_PREDICTIONS' {
        ext.args = params.consensus_mode
        publishDir = [
            path: { "${params.outdir}/identify_novel_lncrnas/combined_predictions" },
            mode: params.publish_dir_mode
        ]
    }

    //==========================
    // SUMMARY_AND_CLASSIFY_LNCRNA
    //==========================

    withName: 'BLAST_MAKEBLASTDB' {
        ext.args = '-dbtype prot'
        publishDir = [
            path: { "${params.outdir}/summary_classify_lncrna/blast" },
            mode: params.publish_dir_mode,
            enabled: params.novel_lncrnas
        ]
    }

    withName: 'FILTER_KNOWN_LNCRNA' {
        publishDir = [
            path: { "${params.outdir}/summary_classify_lncrna/known" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'NFDATAOMICS_LNCRNA:LNCRNA:SUMMARY_AND_CLASSIFY_LNCRNA:GTF_TO_FASTA' {
        publishDir = [
            path: { "${params.outdir}/summary_classify_lncrna/gtf_to_fasta" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BLASTX' {
        publishDir = [
            path: { "${params.outdir}/summary_classify_lncrna/blastx" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_BLAST_RESULTS' {
        publishDir = [
            path: { "${params.outdir}/summary_classify_lncrna/blast" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // withName: 'RENAME_LNCRNA' {
    //     publishDir = [
    //         path: { "${params.outdir}/summary_classify_lncrna/renamed" },
    //         mode: params.publish_dir_mode
    //     ]
    // }

    withName: 'NFDATAOMICS_LNCRNA:LNCRNA:SUMMARY_AND_CLASSIFY_LNCRNA:CLASSIFY_LNCRNA' {
        publishDir = [
            path: { "${params.outdir}/summary_classify_lncrna/classification" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename == 'README.txt') {
                    return "README.txt"
                }
                return filename.startsWith('lncrnas_classification') ? "${filename}" : filename
            }
        ]
    }

    withName: 'MERGE_FINAL_ANNOTATION' {
        publishDir = [
            path: { "${params.outdir}/final_annotation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.startsWith('lncrnas_') ? "${filename}" : filename }
        ]
    }

    //==========================
    // EVALUATE_FINAL_LNCRNA
    //==========================
    // withName: 'EVALUATE_FINAL_LNCRNA' {
    //     publishDir = [
    //         path: { "${params.outdir}/evaluate_final_lncrna" },
    //         mode: params.publish_dir_mode
    //     ]
    // }

    // withName: 'NFDATAOMICS_LNCRNA:LNCRNA:EVALUATE_FINAL_LNCRNA:RERUN_CPAT_LNCRNA' {
    //     cpus = 4
    //     memory = '8.GB'
    //     publishDir = [
    //         path: { "${params.outdir}/evaluate_final_lncrna/cpat_lncrna" },
    //         mode: params.publish_dir_mode
    //     ]
    // }

    // withName: 'NFDATAOMICS_LNCRNA:LNCRNA:EVALUATE_FINAL_LNCRNA:RERUN_CPAT_CODING' {
    //     cpus = 4
    //     memory = '8.GB'
    //     publishDir = [
    //         path: { "${params.outdir}/evaluate_final_lncrna/cpat_coding" },
    //         mode: params.publish_dir_mode
    //     ]
    // }

    // withName: 'GENERATE_FINAL_STATISTICS' {
    //     publishDir = [
    //         path: { "${params.outdir}/evaluate_final_lncrna/stats" },
    //         mode: params.publish_dir_mode
    //     ]
    // }

    //==========================
    // MULTIQC
    //==========================
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
