/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'STAR_ALIGN' {
        ext.args = '--readFilesCommand zcat --outSAMtype BAM Unsorted SortedByCoordinate'
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode
        ]
    }

    // STRINGTIE SUBWORKFLOW
    withName: 'STRINGTIE_STRINGTIE' {
        ext.args = '-e'
        publishDir = [
            path: { "${params.outdir}/stringtie/assembly" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'STRINGTIE_MERGE' {
        publishDir = [
            path: { "${params.outdir}/stringtie/merged" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GFFCOMPARE' {
        ext.args = '-R'
        publishDir = [
            path: { "${params.outdir}/gffcompare" },
            mode: params.publish_dir_mode
        ]
    }

    // FILTERING LNCRNAS TRANSCRIPTS

    withName: 'FASTA_EXTRACT_TRANSCRIPTS' {
        ext.args = '-w'  // obtain transcript sequences
    }

    withName: 'FILTER_TRANSCRIPTS_EXONS' {
        publishDir = [
            path: { "${params.outdir}/lncrna_transcript_filtering/transcripts" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FILTER_TRANSCRIPTS_EXONS' {
        publishDir = [
            path: { "${params.outdir}/lncrna_transcript_filtering/transcripts_exons" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FILTER_TRANSCRIPTS_LENGTH' {
        publishDir = [
            path: { "${params.outdir}/lncrna_transcript_filtering/transcripts_length" },
            mode: params.publish_dir_mode
        ]
    }

     // FILTERING LNCRNAS GTF
    withName: 'FILTER_GTF_BY_CLASSCODE' {
        ext.args = { params.classcodes ?: 'i,u,x,j' }
        publishDir = [
            path: { "${params.outdir}/lncrna_gtf_filtering/by_classcode" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GTF_TO_FASTA' {
        publishDir = [
            path: { "${params.outdir}/lncrna_gtf_filtering/fasta" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS' {
        publishDir = [
            path: { "${params.outdir}/fastq_filter" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'FQ_LINT' {
        ext.args = { params.extra_fqlint_args ?: '' }
    }
    withName: 'FQ_LINT_AFTER_TRIMMING' {
        ext.args = { params.extra_fqlint_args ?: '' }
    }
    withName: 'FQ_LINT_AFTER_BBSPLIT' {
        ext.args = { params.extra_fqlint_args ?: '' }
    }
    withName: 'FQ_LINT_AFTER_RIBO_REMOVAL' {
        ext.args = { params.extra_fqlint_args ?: '' }
    }

    // Extract protein sequences from GTF using gffread (-y)
    withName: 'PROTEIN_EXTRACT' {
        ext.args = '-y'
        ext.prefix = { "${meta.id}" }
    }

    // Make BLAST protein database
    withName: 'BLAST_MAKEBLASTDB' {
        ext.args = '-dbtype prot'
    }
    withName: 'CPAT_BUILD_MODEL' {
        cpus = 4
        memory = '8.GB'
        time = '2.h'
        publishDir = [
            path: { "${params.outdir}/lncrna_prediction/cpat/models" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename }
        ]
    }

    withName: 'CPAT' {
        cpus = 4
        memory = '8.GB'
        publishDir = [
            path: { "${params.outdir}/lncrna_prediction/cpat" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PLEK' {
        publishDir = [
            path: { "${params.outdir}/lncrna_prediction/plek" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'COMBINE_PREDICTIONS' {
        ext.args = params.consensus_mode
        publishDir = [
            path: { "${params.outdir}/lncrna_prediction/combined_predictions" },
            mode: params.publish_dir_mode
        ]
    }

    // BLAST FILTERING
    withName: 'BLASTX' {
        publishDir = [
            path: { "${params.outdir}/lncrna_prediction/blastx" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_BLAST_RESULTS' {
        publishDir = [
            path: { "${params.outdir}/lncrna_prediction/blast_filter" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

     // EXTRACT SEQUENCES
    withName: 'EXTRACT_LNCRNA_SEQUENCES' {
        publishDir = [
            path: { "${params.outdir}/extracted_sequences" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'EXTRACT_MRNA_SEQUENCES' {
        publishDir = [
            path: { "${params.outdir}/extracted_sequences" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'EXTRACT_CDS_SEQUENCES' {
        publishDir = [
            path: { "${params.outdir}/extracted_sequences" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'EXTRACT_PROTEIN_SEQUENCES' {
        publishDir = [
            path: { "${params.outdir}/extracted_sequences" },
            mode: params.publish_dir_mode
        ]
    }

    // FILTERING KNOWN LNCRNAS
    withName: 'FILTER_KNOWN_LNCRNA' {
        publishDir = [
            path: { "${params.outdir}/lncrna_prediction/filter_known" },
            mode: params.publish_dir_mode
        ]
    }

    // RENAME LNCRNAS
    withName: 'RENAME_LNCRNA' {
        publishDir = [
            path: { "${params.outdir}/lncrna_prediction/renamed_lncrnas" },
            mode: params.publish_dir_mode
        ]
    }

    // LNCRNAS CLASSIFICATION
    withName: 'CLASSIFY_LNCRNA' {
        publishDir = [
            path: { "${params.outdir}/lncrna_prediction/classification" },
            mode: params.publish_dir_mode
        ]
    }

    // FINAL ANNOTATION MERGE
    withName: 'MERGE_FINAL_ANNOTATION' {
        publishDir = [
            path: { "${params.outdir}/lncrna_final_annotation" },
            mode: params.publish_dir_mode
        ]
    }

    // FINAL EVALUATION CPAT
    withName: 'EVALUATE_FINAL_LNCRNA' {
        publishDir = [
            path: { "${params.outdir}/lncrna_prediction/evaluation" },
            mode: params.publish_dir_mode
        ]
    }

    // QUANTIFICATION AND COUNTS MATRIX
    withName: 'QUANTIFY_EXPRESSION' {
        publishDir = [
            path: { "${params.outdir}/expression/quantification" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GENERATE_COUNT_MATRIX' {
        publishDir = [
            path: { "${params.outdir}/expression/matrix" },
            mode: params.publish_dir_mode
        ]
    }

    // DIFFERENTIAL EXPRESSION
    withName: 'DIFFERENTIAL_EXPRESSION' {
        publishDir = [
            path: { "${params.outdir}/differential_expression" },
            mode: params.publish_dir_mode
        ]
    }

    // FINAL REPORT
    withName: 'GENERATE_LNCRNA_REPORT' {
        publishDir = [
            path: { "${params.outdir}/lncrna_report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:QUANTIFY_PSEUDO_ALIGNMENT:SE_GENE_UNIFIED' {
        ext.args = '--assay_names counts,counts_length_scaled,counts_scaled,lengths,tpm --coldata_id_col sample'
    }

    withName: '.*:QUANTIFY_PSEUDO_ALIGNMENT:SE_TRANSCRIPT_UNIFIED' {
        ext.args = '--assay_names counts,lengths,tpm --coldata_id_col sample'
    }

}
